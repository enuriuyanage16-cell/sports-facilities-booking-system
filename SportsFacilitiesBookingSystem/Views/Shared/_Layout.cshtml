<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Warmup</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SportsFacilitiesBookingSystem.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=Inter:wght@400;600&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="nav-inner">
                <a class="nav-logo" asp-controller="Home" asp-action="Index">Warmup</a>
                <div class="nav-links">
                    <a asp-controller="Facility" asp-action="Search">Search Facilities</a>
                    <a asp-controller="Review" asp-action="Search">Reviews</a>
                    <a asp-controller="Inquiry" asp-action="Create">Inquiry</a>

                    @if (Context.Session.GetInt32("MemberId") != null)
                    {
                        <div class="nav-avatar">@Context.Session.GetString("MemberName")!.Substring(0, 1).ToUpper()</div>
                        <a asp-controller="Member" asp-action="SignOut">Sign Out</a>
                    }
                    else
                    {
                        <a asp-controller="Member" asp-action="SignIn">Sign In</a>
                        <a class="nav-cta" asp-controller="Member" asp-action="Register">Register</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Warmup - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
