@model SportsFacilitiesBookingSystem.Models.Member

@{
    ViewData["Title"] = "Register";
}

<section class="form-section">
    <div class="form-card">
        <h1>Create Your Account</h1>
        <p class="form-sub">Join Warmup to book facilities, leave reviews, and manage your games.</p>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="MemberName"></label>
                <input asp-for="MemberName" class="form-input" placeholder="Enter your full name" />
                <span asp-validation-for="MemberName" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="MemberPhoneNumber"></label>
                <input asp-for="MemberPhoneNumber" class="form-input" placeholder="07XXXXXXXX" />
                <span asp-validation-for="MemberPhoneNumber" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="MemberEmail"></label>
                <input asp-for="MemberEmail" class="form-input" placeholder="name@example.com" />
                <span asp-validation-for="MemberEmail" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="MemberAddress"></label>
                <input asp-for="MemberAddress" class="form-input" placeholder="Enter your address" />
                <span asp-validation-for="MemberAddress" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="MemberPassword"></label>
                <input asp-for="MemberPassword" class="form-input" placeholder="Enter at least 6 characters" />
                <span asp-validation-for="MemberPassword" class="field-error"></span>
            </div>

            <button type="submit" class="btn-solid form-submit">Create Account</button>
        </form>
    </div>
</section>
