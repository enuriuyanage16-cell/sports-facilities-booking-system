@{
    ViewData["Title"] = "Sign In";
}

<section class="form-section">
    <div class="form-card">
        <h1>Welcome Back</h1>
        <p class="form-sub">Sign in to book facilities and manage your reviews.</p>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="field-error-box">@ViewBag.ErrorMessage</div>
        }

        <form asp-action="SignIn" method="post">
            <div class="form-group">
                <label for="MemberEmail">Email</label>
                <input type="email" name="MemberEmail" class="form-input" placeholder="name@example.com" required />
            </div>

            <div class="form-group">
                <label for="MemberPassword">Password</label>
                <input type="password" name="MemberPassword" class="form-input" placeholder="Enter your password" required />
            </div>

            <button type="submit" class="btn-solid form-submit">Sign In</button>
        </form>

        <p class="form-footer-text">Don't have an account? <a asp-controller="Member" asp-action="Register">Register here</a></p>
    </div>
</section>