@model SportsFacilitiesBookingSystem.Models.Facility

@{
    ViewData["Title"] = "Book Facility";

    decimal suggestedPrice = Model.FacilityType switch
    {
        var t when t.Contains("Tennis") => 2000m,
        var t when t.Contains("Soccer") => 4000m,
        var t when t.Contains("Basketball") => 2500m,
        var t when t.Contains("Swimming") => 1500m,
        var t when t.Contains("Boxing") => 2000m,
        _ => 2000m
    };
}

<section class="form-section">
    <div class="form-card">
        <h1>Book @Model.FacilityName</h1>
        <p class="form-sub">@Model.FacilityType &middot; @Model.FacilityLocation</p>
        <p class="form-sub">Open @Model.OpeningTime - @Model.ClosingTime</p>

        <form asp-action="Book" method="post">
            <input type="hidden" name="facilityId" value="@Model.FacilityId" />

            <div class="form-group">
                <label>Date</label>
                <input type="date" name="bookingDate" class="form-input" required />
            </div>

            <div class="form-group">
                <label>Start Time</label>
                <input type="time" name="startTime" class="form-input" required />
            </div>

            <div class="form-group">
                <label>End Time</label>
                <input type="time" name="endTime" class="form-input" required />
            </div>

            <div class="form-group">
                <label>Amount (Rs.)</label>
                <input type="number" name="amount" class="form-input" value="@suggestedPrice" step="0.01" required />
            </div>

            <div class="form-group">
                <label>Payment Method</label>
                <select name="paymentMethod" class="form-input" required>
                    <option value="Card">Card</option>
                    <option value="Online Transfer">Online Transfer</option>
                </select>
            </div>

            <button type="submit" class="btn-solid form-submit">Confirm & Pay</button>
        </form>
    </div>
</section>