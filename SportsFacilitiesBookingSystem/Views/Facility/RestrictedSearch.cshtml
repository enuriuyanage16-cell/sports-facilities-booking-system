@model List<SportsFacilitiesBookingSystem.Models.Facility>

@{
    ViewData["Title"] = "Search Facilities";
}

<section class="search-section">
    <h1 class="section-title">Search Facilities</h1>
    <p class="section-sub">Browse available facilities, sign in to see full details and book</p>

    <form asp-action="RestrictedSearch" method="get" class="search-form">
        <div class="search-field">
            <label>Sport / Type</label>
            <input type="text" name="facilityType" class="form-input" placeholder="e.g. Tennis" value="@Context.Request.Query["facilityType"]" />
        </div>
        <div class="search-field">
            <label>Date</label>
            <input type="date" name="searchDate" class="form-input" value="@Context.Request.Query["searchDate"]" />
        </div>
        <div class="search-field">
            <label>Start Time</label>
            <input type="time" name="startTime" class="form-input" value="@Context.Request.Query["startTime"]" />
        </div>
        <div class="search-field">
            <label>End Time</label>
            <input type="time" name="endTime" class="form-input" value="@Context.Request.Query["endTime"]" />
        </div>
        <button type="submit" class="btn-solid search-btn">Search</button>
    </form>

    <div class="results-grid">
        @if (Model.Count == 0)
        {
            <p class="no-results">No facilities found. Try adjusting your search.</p>
        }
        else
        {
            @foreach (var facility in Model)
            {
                <div class="result-card">
                    <h3>@facility.FacilityName</h3>
                    <p class="result-type">@facility.FacilityType &middot; @facility.FacilityLocation</p>
                    <p class="result-meta">Status: @facility.FacilityAvailabilityStatus</p>
                </div>
            }
        }
    </div>

    <p class="form-footer-text">Want to see full details and book? <a asp-controller="Member" asp-action="SignIn">Sign in</a></p>
</section>